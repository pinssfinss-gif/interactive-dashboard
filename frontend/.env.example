# Frontend Environment Variables
# Copy this file to .env and fill in your actual values

# API Configuration
VITE_API_URL=http://localhost:5000/api
VITE_API_TIMEOUT=30000

# Application
VITE_APP_NAME=Health Dashboard Saudi Arabia
VITE_APP_VERSION=1.0.0
VITE_APP_DESCRIPTION=Comprehensive health monitoring dashboard for Saudi Arabia

# Environment
VITE_ENV=development

# Features
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_ERROR_TRACKING=true

# Map Configuration
VITE_MAP_CENTER_LAT=24.7136
VITE_MAP_CENTER_LNG=46.6753
VITE_MAP_ZOOM=5
VITE_MAP_TOKEN=your_map_token

# Theme
VITE_THEME_MODE=light
VITE_THEME_PRIMARY_COLOR=#1976d2

# Localization
VITE_DEFAULT_LANGUAGE=en
VITE_SUPPORTED_LANGUAGES=en,ar

# Authentication
VITE_AUTH_STORAGE_KEY=health_dashboard_auth
VITE_TOKEN_STORAGE_KEY=health_dashboard_token
VITE_REFRESH_TOKEN_STORAGE_KEY=health_dashboard_refresh_token

# Monitoring & Logging
VITE_LOG_LEVEL=debug
VITE_ENABLE_CONSOLE_LOGS=true
