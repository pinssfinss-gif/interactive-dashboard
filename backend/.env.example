# Backend Environment Variables
# Copy this file to .env and fill in your actual values

# Server Configuration
PORT=5000
NODE_ENV=development

# Database
MONGO_URI=mongodb://localhost:27017/health-dashboard
MONGO_DB_NAME=health-dashboard

# Authentication
JWT_SECRET=your_jwt_secret_key_change_this_in_production
JWT_EXPIRE=7d
JWT_REFRESH_EXPIRE=30d

# CORS
CORS_ORIGIN=http://localhost:3000
CORS_CREDENTIALS=true

# Logging
LOG_LEVEL=debug
LOG_FORMAT=combined

# Email (Optional - for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=noreply@health-dashboard.sa

# API Configuration
API_TIMEOUT=30000
MAX_REQUEST_SIZE=10mb

# Redis (Optional - for caching/sessions)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# File Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=50mb
ALLOWED_FILE_TYPES=pdf,jpg,jpeg,png,doc,docx

# Third Party APIs (Optional)
# Weather API for environmental health tracking
WEATHER_API_KEY=your_weather_api_key

# Map Services
MAP_API_KEY=your_map_api_key

# Application Settings
APP_NAME=Health Dashboard Saudi Arabia
APP_VERSION=1.0.0
