# Production Environment Variables - Root Level
# This file is for reference only. Do NOT commit to version control.

# Backend
BACKEND_PORT=5000
BACKEND_NODE_ENV=production

# Frontend  
FRONTEND_PORT=3000

# Database
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/health-dashboard
MONGO_DB_NAME=health-dashboard

# Authentication
JWT_SECRET=your_super_secure_production_jwt_secret_key_here
JWT_EXPIRE=7d

# CORS
CORS_ORIGIN=https://your-domain.com

# Logging
LOG_LEVEL=info

# API
VITE_API_URL=https://api.your-domain.com/api

# SSL/TLS
SSL_CERT_PATH=/etc/ssl/certs/your-cert.crt
SSL_KEY_PATH=/etc/ssl/private/your-key.key
